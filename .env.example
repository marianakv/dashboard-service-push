# Mixpanel — Service Account (Project Settings > Service Accounts na Mixpanel)
# Mesmos nomes e mesmos endpoints (/engage, /export) já comprovados
# funcionando na ferramenta Python existente no VS Code da Predialize —
# NÃO a Query API nova (/jql, /insights), que retorna 402 no plano Free.
APP_USERNAME=
APP_SECRET=
APP_PROJECT_ID=2214085

# Projeto Admin do Mixpanel (3444168) — existe no .env padrão da Predialize,
# mas este serviço NÃO usa (o painel de engajamento só lê do projeto "App").
ADMIN_USERNAME=
ADMIN_SECRET=
ADMIN_PROJECT_ID=3444168

# Notion — Integration própria (notion.so/my-integrations), compartilhada
# explicitamente com a base "Predialize — Empresas e Empreendimentos"
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=a661b348-35ed-4e14-bc08-d0d84aeb10b4

# Anthropic — só necessário se usar_claude=true nas chamadas
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
