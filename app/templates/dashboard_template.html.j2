<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ cliente }} — Painel de Engajamento no App</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.min.js"></script>
<style>
  :root {
    --bg: #0a0f1e; --surface: #111827; --surface2: #1a2540; --border: rgba(255,255,255,0.07);
    --accent: #3b82f6; --accent2: #6366f1; --accent3: #10b981; --accent4: #f59e0b; --accent5: #ef4444;
    --text: #f1f5f9; --muted: #64748b;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background: var(--bg); color: var(--text); font-family: 'Calibri', 'Carlito', 'Candara', 'Segoe UI', sans-serif;
    min-height: 100vh; overflow-x: hidden;
  }
  body::before {
    content: ''; position: fixed; inset: 0;
    background-image: linear-gradient(rgba(59,130,246,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.04) 1px, transparent 1px);
    background-size: 40px 40px; pointer-events: none; z-index: 0;
  }
  .container { position: relative; z-index: 1; max-width: 1400px; margin: 0 auto; padding: 48px 32px 80px; }
  header { margin-bottom: 32px; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .logo-area { display: flex; flex-direction: column; gap: 8px; }
  .logo { font-size: 13px; font-weight: 700; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); }
  h1 {
    font-size: clamp(28px, 4vw, 44px); font-weight: 800; line-height: 1.1;
    background: linear-gradient(135deg, #f1f5f9 0%, #94a3b8 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .subtitle { font-size: 14px; color: var(--muted); max-width: 480px; line-height: 1.6; }
  .meta-badges { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .badge { padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 500; border: 1px solid; }
  .badge-blue { border-color: rgba(59,130,246,0.4); background: rgba(59,130,246,0.1); color: #93c5fd; }
  .badge-amber { border-color: rgba(245,158,11,0.4); background: rgba(245,158,11,0.1); color: #fcd34d; }
  .pdf-btn {
    padding: 6px 14px; border-radius: 100px; font-size: 12px; font-weight: 500;
    border: 1px solid rgba(59,130,246,0.4); background: rgba(59,130,246,0.12); color: #93c5fd;
    cursor: pointer; font-family: inherit;
  }
  .pdf-btn:hover { background: rgba(59,130,246,0.22); }

  .tab-nav { display: flex; gap: 6px; margin-bottom: 32px; border-bottom: 1px solid var(--border); }
  .tab-btn {
    padding: 10px 18px; border: none; background: transparent; color: var(--muted);
    font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer;
    border-bottom: 2px solid transparent; margin-bottom: -1px; transition: color 0.15s, border-color 0.15s;
  }
  .tab-btn:hover { color: #cbd5e1; }
  .tab-btn.active { color: var(--text); border-bottom-color: var(--accent); }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  .sort-row { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; font-size: 12.5px; color: var(--muted); }
  .sort-row select {
    background: var(--surface); border: 1px solid var(--border); color: var(--text);
    padding: 6px 10px; border-radius: 8px; font-family: inherit; font-size: 12.5px;
  }

  .detail-view { display: none; }
  .detail-view.active { display: block; }
  .detail-back {
    display: inline-block; margin-bottom: 20px; font-size: 12.5px; color: var(--accent);
    text-decoration: none; cursor: pointer; background: none; border: none; font-family: inherit; padding: 0;
  }
  .detail-back:hover { text-decoration: underline; }
  .detail-title-row { display: flex; align-items: center; gap: 14px; margin-bottom: 8px; }
  .detail-title { font-size: 26px; font-weight: 800; }
  .detail-desc { font-size: 13px; color: #cbd5e1; line-height: 1.6; max-width: 780px; margin-bottom: 28px; }
  .detail-subtitle { font-size: 12px; color: var(--muted); margin-bottom: 14px; letter-spacing: 0.1em; text-transform: uppercase; }
  .detail-base-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 32px; }
  .detail-indicators { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 16px; }
  .detail-benchmark {
    font-size: 12.5px; color: #94a3b8; line-height: 1.6; margin-bottom: 32px; padding: 12px 16px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
  }
  .detail-chart-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; margin-bottom: 20px; }

  @media print {
    body::before { display: none; }
    body { background: #ffffff; color: #0f172a; }
    .container { max-width: 100%; padding: 16px; }
    .pdf-btn, .tab-nav, .sort-row { display: none; }
    .tab-panel { display: block !important; }
    .metric-card, .emp-card, .chart-panel, .funnel-card, .priority-col {
      background: #f8fafc; border: 1px solid #cbd5e1; break-inside: avoid;
    }
    h1, .logo, .section-label, .emp-name, .metric-value, .funnel-name, .funnel-conv {
      color: #0f172a !important; -webkit-text-fill-color: #0f172a !important;
    }
    .metric-label, .emp-stat-label, .chart-sub, .subtitle { color: #475569 !important; }
    .emp-note, .priority-item, .feature-name { color: #1e293b !important; }
    .cards-grid { grid-template-columns: 1fr 1fr !important; }
  }

  .section-label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
    margin-bottom: 20px; display: flex; align-items: center; gap: 10px;
  }
  .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .divider { height: 1px; background: var(--border); margin: 48px 0; }

  .metrics-row { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 14px; margin-bottom: 40px; }
  .metric-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; text-align: center; }
  .metric-value {
    font-size: 28px; font-weight: 800;
    background: linear-gradient(135deg, #f1f5f9, #94a3b8);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 4px;
  }
  .metric-label { font-size: 11.5px; color: var(--muted); line-height: 1.4; }

  .charts-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; margin-bottom: 40px; }
  @media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }
  .chart-panel { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; }
  .chart-panel h3 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .chart-panel .chart-sub { font-size: 12px; color: var(--muted); margin-bottom: 16px; }
  .chart-wrap { position: relative; height: 280px; }
  .chart-wrap canvas { max-width: 100%; height: auto; }

  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-bottom: 40px; }
  .emp-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px;
    position: relative; overflow: hidden; cursor: pointer; transition: border-color 0.15s, transform 0.15s;
  }
  .emp-card:hover { border-color: rgba(59,130,246,0.4); transform: translateY(-2px); }
  .emp-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: 16px 16px 0 0; }
  .cls-declinio::before { background: linear-gradient(90deg, #f59e0b, #d97706); }
  .cls-lancamento_recente::before { background: linear-gradient(90deg, #3b82f6, #6366f1); }
  .cls-cadastro_pendente::before { background: linear-gradient(90deg, #60a5fa, #2563eb); }

  .emp-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 6px; }
  .emp-name { font-size: 17px; font-weight: 700; }
  .emp-sub { font-size: 11px; color: var(--muted); margin-bottom: 14px; }
  .emp-status { font-size: 10px; font-weight: 600; padding: 3px 9px; border-radius: 100px; white-space: nowrap; flex-shrink: 0; }
  .status-declinio { background: rgba(245,158,11,0.2); color: #fcd34d; border: 1px solid rgba(245,158,11,0.3); }
  .status-lancamento_recente { background: rgba(59,130,246,0.2); color: #93c5fd; border: 1px solid rgba(59,130,246,0.3); }
  .status-cadastro_pendente { background: rgba(96,165,250,0.2); color: #93c5fd; border: 1px solid rgba(96,165,250,0.3); }

  .emp-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 16px 0; }
  .emp-stat-value { font-size: 20px; font-weight: 800; }
  .emp-stat-label { font-size: 10px; color: var(--muted); margin-top: 2px; }
  .anomaly-banner {
    background: rgba(239,68,68,0.14); border: 1px solid rgba(239,68,68,0.4); border-radius: 8px;
    padding: 10px 12px; font-size: 11.5px; color: #fca5a5; line-height: 1.5; margin: 12px 0; font-weight: 500;
  }
  .freq-bar { height: 8px; border-radius: 4px; background: var(--surface2); overflow: hidden; display: flex; margin: 6px 0 4px; }
  .freq-once { background: #475569; }
  .freq-recur { background: linear-gradient(90deg, #3b82f6, #6366f1); }
  .freq-legend { font-size: 10.5px; color: var(--muted); display: flex; justify-content: space-between; }
  .emp-note { font-size: 12px; color: #94a3b8; line-height: 1.55; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }

  .funnel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 14px; margin-bottom: 40px; }
  .funnel-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px; }
  .funnel-name { font-size: 13px; font-weight: 700; margin-bottom: 10px; }
  .funnel-steps { display: flex; align-items: baseline; gap: 6px; font-size: 11px; color: var(--muted); margin-bottom: 8px; }
  .funnel-steps b { font-size: 18px; color: var(--text); font-weight: 800; }
  .funnel-conv { font-size: 20px; font-weight: 800; }
  .funnel-conv-label { font-size: 10px; color: var(--muted); }
  .conv-ok { color: #6ee7b7; }
  .conv-lowvol { color: #fca5a5; }

  .feature-list { list-style: none; counter-reset: feat; }
  .feature-list li { counter-increment: feat; display: flex; align-items: center; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--border); font-size: 12.5px; color: #cbd5e1; }
  .feature-list li:last-child { border-bottom: none; }
  .feature-list li::before {
    content: counter(feat); font-size: 10px; font-weight: 700; color: var(--muted);
    width: 18px; height: 18px; border-radius: 5px; background: var(--surface2);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .feature-name { flex: 1; }
  .feature-count { font-weight: 700; color: var(--text); font-size: 12.5px; }

  .os-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 12px; }
  .os-label { width: 78px; color: #94a3b8; flex-shrink: 0; }
  .os-bar-track { flex: 1; height: 10px; border-radius: 5px; background: var(--surface2); overflow: hidden; }
  .os-bar-fill { height: 100%; background: linear-gradient(90deg, #3b82f6, #6366f1); }
  .os-pct { width: 44px; text-align: right; color: var(--muted); font-size: 11px; flex-shrink: 0; }

  .priority-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 900px) { .priority-grid { grid-template-columns: 1fr; } }
  .priority-col { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
  .priority-header { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; font-size: 13px; font-weight: 700; }
  .priority-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .dot-amber { background: #f59e0b; } .dot-blue { background: #3b82f6; } .dot-red { background: #ef4444; }
  .priority-item {
    padding: 10px; background: var(--surface2); border-radius: 8px; margin-bottom: 8px;
    font-size: 12px; color: #94a3b8; line-height: 1.45; border-left: 2px solid transparent;
  }
  .pi-amber { border-left-color: rgba(245,158,11,0.5); }
  .pi-blue { border-left-color: rgba(59,130,246,0.5); }
  .pi-red { border-left-color: rgba(239,68,68,0.5); }

  footer { margin-top: 60px; text-align: center; color: #334155; font-size: 12px; }
</style>
</head>
<body>
<div class="container">

  <header>
    <div class="logo-area">
      <span class="logo">Predialize · {{ cliente }}</span>
      <h1>Painel de Engajamento<br>no App</h1>
      <p class="subtitle">Usuários ativos, tendência mensal e padrão de acesso nos empreendimentos de {{ cliente }} na plataforma.</p>
    </div>
    <div class="meta-badges">
      <span class="badge badge-blue">Cliente: {{ cliente }}</span>
      <span class="badge badge-amber">Janela: {{ janela_label }}</span>
      <button onclick="window.print()" class="pdf-btn">⬇ Exportar PDF</button>
    </div>
  </header>

  <nav class="tab-nav">
    <button class="tab-btn active" data-tab="geral" onclick="switchTab('geral')">Painel geral</button>
    <button class="tab-btn" data-tab="empreendimentos" onclick="switchTab('empreendimentos')">Por empreendimento</button>
  </nav>

  <div class="tab-panel active" data-tab="geral">

  <div class="section-label">Visão Geral</div>
  <div class="metrics-row">
    <div class="metric-card">
      <div class="metric-value">{{ total_usuarios }}</div>
      <div class="metric-label">Usuários únicos ativos<br>somados nos empreendimentos</div>
    </div>
    <div class="metric-card">
      <div class="metric-value">{{ n_declinio }}</div>
      <div class="metric-label">Empreendimentos em<br>declínio pós-lançamento</div>
    </div>
    <div class="metric-card">
      <div class="metric-value">{{ n_cadastro_pendente }}</div>
      <div class="metric-label">Empreendimentos com<br>cadastro pendente</div>
    </div>
    <div class="metric-card">
      <div class="metric-value">{{ n_lancamento_recente }}</div>
      <div class="metric-label">Empreendimento(s) em<br>lançamento recente</div>
    </div>
    {% if destaque_stat %}
    <div class="metric-card">
      <div class="metric-value">{{ destaque_stat.valor }}</div>
      <div class="metric-label">{{ destaque_stat.label | safe }}</div>
    </div>
    {% endif %}
  </div>

  <div class="section-label">Tendência Mensal e Padrão de Acesso</div>
  <div class="charts-grid">
    <div class="chart-panel">
      <h3>Usuários únicos ativos por mês</h3>
      <div class="chart-sub">{{ janela_curta }}</div>
      <div class="chart-wrap"><canvas id="trendChart" width="760" height="280"></canvas></div>
    </div>
    <div class="chart-panel">
      <h3>Acesso único vs. recorrente</h3>
      <div class="chart-sub">% de usuários por nº de acessos no período</div>
      <div class="chart-wrap"><canvas id="freqChart" width="520" height="280"></canvas></div>
    </div>
  </div>

  <div class="section-label">Funil de Acesso — Viu login → Iniciou sessão (janela de 1 dia)</div>
  <div class="funnel-grid">
    {% for e in empreendimentos %}
    <div class="funnel-card">
      <div class="funnel-name">{{ e.nome }}</div>
      {% if e.funil_amostra_pequena %}
      <div class="funnel-steps"><b>{{ e.funil_viu_login }}</b> viu login <b>→</b> {{ e.funil_iniciou_sessao }} sessão</div>
      <div class="funnel-conv conv-lowvol">amostra pequena</div>
      <div class="funnel-conv-label">volume insuficiente p/ ler</div>
      {% else %}
      <div class="funnel-steps">{{ e.funil_viu_login }} viu login <b>→</b> {{ e.funil_iniciou_sessao }} sessão</div>
      <div class="funnel-conv conv-ok">{{ "%.1f"|format(e.funil_conversao_pct) }}%</div>
      <div class="funnel-conv-label">converteu no mesmo dia</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="section-label">Perfil de Uso — Base {{ cliente }} Completa</div>
  <div class="charts-grid">
    <div class="chart-panel">
      <h3>Funcionalidades mais usadas</h3>
      <div class="chart-sub">Usuários únicos · toda a base {{ cliente }}</div>
      <ol class="feature-list">
        {% for f in funcionalidades %}
        <li><span class="feature-name">{{ f.nome }}</span><span class="feature-count">{{ f.usuarios }}</span></li>
        {% endfor %}
      </ol>
    </div>
    <div class="chart-panel">
      <h3>Sistema operacional</h3>
      <div class="chart-sub">Usuários únicos ativos · {{ janela_curta }}</div>
      <div style="margin-top:8px;">
        {% for os in sistema_operacional %}
        <div class="os-row"><span class="os-label">{{ os.nome }}</span><div class="os-bar-track"><div class="os-bar-fill" style="width:{{ os.pct }}%"></div></div><span class="os-pct">{{ os.pct }}%</span></div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="charts-grid" style="grid-template-columns: 1fr 1.2fr;">
    <div class="chart-panel">
      <h3>Sistemas construtivos mais acessados</h3>
      <div class="chart-sub">Conteúdo de Manutenção e Uso · usuários únicos</div>
      <ol class="feature-list">
        {% for s in sistemas_construtivos %}
        <li><span class="feature-name">{{ s.nome }}</span><span class="feature-count">{{ s.usuarios }}</span></li>
        {% endfor %}
      </ol>
    </div>
    <div class="chart-panel">
      <h3>Top 10 usuários</h3>
      <div class="chart-sub">Total de acessos · {{ janela_curta }}</div>
      <ol class="feature-list">
        {% for u in top10_usuarios %}
        <li><span class="feature-name">{{ u.nome }}{% if u.nota %} <em style="color:#94a3b8; font-style:normal;">— {{ u.nota }}</em>{% endif %} · {{ u.empreendimento }}</span><span class="feature-count">{{ u.acessos }}</span></li>
        {% endfor %}
      </ol>
    </div>
  </div>

  {% set automacao_list = empreendimentos | selectattr('automacao_data_fmt') | list %}
  {% if automacao_list %}
  <div class="section-label">Automação de Preventivos × Tempo até o Pico</div>
  <div class="funnel-grid">
    {% for e in automacao_list %}
    <div class="funnel-card">
      <div class="funnel-name">{{ e.nome }}</div>
      <div class="funnel-steps">automação {{ e.automacao_data_fmt }}</div>
      <div class="funnel-conv conv-ok">{{ e.meses_ate_pico }}</div>
      <div class="funnel-conv-label">até o pico ({{ e.mes_pico }})</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <div class="divider"></div>

  <div class="section-label">Leitura por Segmento — e a Ação Que Cada Um Pede</div>
  <div class="priority-grid">
    {% for seg in segmentos %}
    <div class="priority-col">
      <div class="priority-header"><div class="priority-dot dot-{{ seg.cor }}"></div>{{ seg.titulo }}</div>
      <div class="priority-item pi-{{ seg.cor }}">{{ seg.empreendimentos_nomes | join(', ') }}</div>
      {% for item in seg.itens %}
      <div class="priority-item pi-{{ seg.cor }}">{{ item }}</div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  <footer>{{ cliente }} — Painel de Engajamento no App · Predialize · {{ gerado_em }}</footer>

  </div>

  <div class="tab-panel" data-tab="empreendimentos">

  <div id="empreendimentosGrid">
  <div class="section-label">Os {{ empreendimentos | length }} Empreendimentos</div>
  <div class="sort-row">
    <label for="sortSelect">Ordenar por</label>
    <select id="sortSelect" onchange="sortCards(this.value)">
      <option value="usuarios">Usuários únicos</option>
      <option value="pct">% unidades cadastradas</option>
      <option value="taxa">Taxa de adoção sobre unidades</option>
      <option value="categoria">Categoria</option>
    </select>
  </div>
  <div class="cards-grid" id="cardsGrid">
    {% for e in empreendimentos %}
    <div class="emp-card cls-{{ e.categoria }}" data-usuarios="{{ e.usuarios_unicos }}" data-pct="{{ e.pct_cadastrado }}" data-taxa="{{ e.taxa_unidades }}" data-categoria="{{ loop.index0 }}" onclick="showDetail('{{ e.slug }}')">
      <div class="emp-header">
        <div><div class="emp-name">{{ e.nome }}</div><div class="emp-sub">{{ e.nome_mixpanel }}</div></div>
        <span class="emp-status status-{{ e.categoria }}">{{ e.status_label }}</span>
      </div>
      <div class="emp-stats">
        <div><div class="emp-stat-value">{{ e.usuarios_unicos }}</div><div class="emp-stat-label">usuários únicos</div></div>
        <div><div class="emp-stat-value">{{ e.total_unidades }}</div><div class="emp-stat-label">unidades ({{ e.pct_cadastrado }}% cadastradas)</div></div>
        <div><div class="emp-stat-value">{{ e.taxa_unidades }}%</div><div class="emp-stat-label">taxa de adoção real</div></div>
        <div><div class="emp-stat-value">{{ e.ultimo_mes_valor }}</div><div class="emp-stat-label">último mês ({{ e.ultimo_mes_label }})</div></div>
      </div>
      <div class="freq-bar"><div class="freq-once" style="width:{{ e.acesso_unico_pct }}%"></div><div class="freq-recur" style="width:{{ e.acesso_recorrente_pct }}%"></div></div>
      <div class="freq-legend"><span>{{ e.acesso_unico_pct }}% só 1 acesso</span><span>{{ e.acesso_recorrente_pct }}% recorrente</span></div>
      {% if e.anomaly_note %}<div class="anomaly-banner">{{ e.anomaly_note }}</div>{% endif %}
      <div class="emp-note">{{ e.observacao }}</div>
    </div>
    {% endfor %}
  </div>
  </div>

  <div id="empreendimentosDetail" class="detail-view">
    <button class="detail-back" onclick="showGrid()">← Todos os empreendimentos</button>
    {% for e in empreendimentos %}
    <div id="detail-{{ e.slug }}" class="detail-block" style="display:none;">
      <div class="detail-title-row"><div class="detail-title">{{ e.nome }}</div><span class="emp-status status-{{ e.categoria }}">{{ e.categoria_label }}</span></div>
      <div class="detail-desc">{{ e.observacao }}{% if e.anomaly_note %} {{ e.anomaly_note }}{% endif %}</div>
      <div class="detail-subtitle">Base do cálculo</div>
      <div class="detail-base-row">
        <div class="metric-card"><div class="metric-value">{{ e.total_unidades }}</div><div class="metric-label">Total de unidades</div></div>
        <div class="metric-card"><div class="metric-value">{{ e.proprietarios_cadastrados }}</div><div class="metric-label">Proprietários cadastrados</div></div>
        <div class="metric-card"><div class="metric-value">{{ e.usuarios_unicos }}</div><div class="metric-label">Usuários únicos ativos<br>Janela {{ janela_curta }}</div></div>
      </div>
      <div class="detail-subtitle">Indicadores</div>
      <div class="detail-indicators">
        <div class="metric-card"><div class="metric-value">{{ e.pct_cadastrado }}%</div><div class="metric-label">Unidades com proprietário</div></div>
        <div class="metric-card"><div class="metric-value">{{ e.taxa_unidades }}%</div><div class="metric-label">Adoção sobre unidades</div></div>
        <div class="metric-card"><div class="metric-value">{{ e.taxa_cadastrados if e.taxa_cadastrados is not none else "n/a" }}{% if e.taxa_cadastrados is not none %}%{% endif %}</div><div class="metric-label">Adoção sobre cadastrados</div></div>
        <div class="metric-card"><div class="metric-value">{{ "%.1f"|format(e.funil_conversao_pct) + "%" if not e.funil_amostra_pequena else "amostra pequena" }}</div><div class="metric-label">Conversão do funil</div></div>
      </div>
      {% if e.benchmark_taxa %}
      <div class="detail-benchmark">Adoção sobre unidades de <strong style="color:#e2e8f0">{{ e.taxa_unidades }}%</strong> contra média de <strong style="color:#e2e8f0">{{ e.benchmark_taxa }}%</strong> dos demais empreendimentos com cadastro concluído — {{ e.benchmark_direcao }} da referência.</div>
      {% endif %}
      <div class="detail-chart-panel">
        <h3 style="font-size:14px; font-weight:700; margin-bottom:4px;">Tendência mensal</h3>
        <div class="chart-sub" style="margin-bottom:16px;">Usuários únicos por mês · {{ janela_curta }}</div>
        <div class="chart-wrap"><canvas id="detailChart-{{ e.slug }}" width="900" height="240"></canvas></div>
      </div>
    </div>
    {% endfor %}
  </div>

  </div>

</div>

<script>
const months = {{ meses | tojson }};
const trendData = {
  {% for e in empreendimentos %}"{{ e.nome }}": {{ e.tendencia_mensal | tojson }}{{ "," if not loop.last }}
  {% endfor %}
};
const colors = {
  {% for e in empreendimentos %}"{{ e.nome }}": "{{ e.cor }}"{{ "," if not loop.last }}
  {% endfor %}
};

Chart.defaults.global.defaultFontColor = "#94a3b8";
Chart.defaults.global.defaultFontFamily = "'Calibri', 'Carlito', 'Candara', 'Segoe UI', sans-serif";
Chart.defaults.global.defaultFontSize = 11;

var trendDatasets = Object.keys(trendData).map(function(name) {
  return { label: name, data: trendData[name], borderColor: colors[name], backgroundColor: colors[name], fill: false, lineTension: 0.35, pointRadius: 2, borderWidth: 2 };
});

new Chart(document.getElementById('trendChart'), {
  type: 'line',
  data: { labels: months, datasets: trendDatasets },
  options: {
    responsive: false, animation: false,
    legend: { position: 'bottom', labels: { boxWidth: 10, padding: 10 } },
    scales: {
      xAxes: [{ gridLines: { color: 'rgba(255,255,255,0.05)' } }],
      yAxes: [{ gridLines: { color: 'rgba(255,255,255,0.05)' }, ticks: { beginAtZero: true } }]
    }
  }
});

new Chart(document.getElementById('freqChart'), {
  type: 'horizontalBar',
  data: {
    labels: [{% for e in empreendimentos %}"{{ e.nome }}"{{ "," if not loop.last }}{% endfor %}],
    datasets: [
      { label: '1 acesso só', data: [{% for e in empreendimentos %}{{ e.acesso_unico_pct }}{{ "," if not loop.last }}{% endfor %}], backgroundColor: '#475569' },
      { label: 'Recorrente (2x+)', data: [{% for e in empreendimentos %}{{ e.acesso_recorrente_pct }}{{ "," if not loop.last }}{% endfor %}], backgroundColor: '#3b82f6' }
    ]
  },
  options: {
    responsive: false, animation: false,
    legend: { position: 'bottom', labels: { boxWidth: 10, padding: 10 } },
    scales: {
      xAxes: [{ stacked: true, ticks: { max: 100, beginAtZero: true, callback: function(v){ return v + '%'; } }, gridLines: { color: 'rgba(255,255,255,0.05)' } }],
      yAxes: [{ stacked: true, gridLines: { display: false } }]
    }
  }
});

function switchTab(name) {
  document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-tab') === name); });
  document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.toggle('active', p.getAttribute('data-tab') === name); });
  window.scrollTo(0, 0);
}

function sortCards(key) {
  var grid = document.getElementById('cardsGrid');
  var cards = Array.prototype.slice.call(grid.children);
  cards.sort(function(a, b) {
    if (key === 'usuarios') return parseFloat(b.dataset.usuarios) - parseFloat(a.dataset.usuarios);
    if (key === 'pct') return parseFloat(b.dataset.pct) - parseFloat(a.dataset.pct);
    if (key === 'taxa') return parseFloat(b.dataset.taxa) - parseFloat(a.dataset.taxa);
    if (key === 'categoria') return parseFloat(a.dataset.categoria) - parseFloat(b.dataset.categoria);
    return 0;
  });
  cards.forEach(function(c) { grid.appendChild(c); });
}

function showDetail(slug) {
  document.getElementById('empreendimentosGrid').style.display = 'none';
  document.getElementById('empreendimentosDetail').classList.add('active');
  document.querySelectorAll('.detail-block').forEach(function(d) { d.style.display = 'none'; });
  var block = document.getElementById('detail-' + slug);
  if (block) block.style.display = 'block';
  window.scrollTo(0, 0);
}

function showGrid() {
  document.getElementById('empreendimentosDetail').classList.remove('active');
  document.getElementById('empreendimentosGrid').style.display = 'block';
  window.scrollTo(0, 0);
}

var detailSlugToName = {
  {% for e in empreendimentos %}"{{ e.slug }}": "{{ e.nome }}"{{ "," if not loop.last }}
  {% endfor %}
};

Object.keys(detailSlugToName).forEach(function(slug) {
  var canvas = document.getElementById('detailChart-' + slug);
  if (!canvas) return;
  var key = detailSlugToName[slug];
  new Chart(canvas, {
    type: 'line',
    data: { labels: months, datasets: [{ label: key, data: trendData[key], borderColor: colors[key], backgroundColor: colors[key], fill: false, lineTension: 0.35, pointRadius: 3, borderWidth: 2 }] },
    options: {
      responsive: false, animation: false,
      legend: { display: false },
      scales: {
        xAxes: [{ gridLines: { color: 'rgba(255,255,255,0.05)' } }],
        yAxes: [{ gridLines: { color: 'rgba(255,255,255,0.05)' }, ticks: { beginAtZero: true } }]
      }
    }
  });
});
</script>

</body>
</html>
